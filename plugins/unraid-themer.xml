<Plugin>
  <!-- Required fields -->
  <Name>Unraid Themer</Name>

  <Overview>Theme the Unraid 7 webGUI: pick a bundled theme or build your own from 8 colors, browse a built-in theme store, swap the UI icons for 9 open-source icon sets (or override any single icon), and set a custom background image and logo. Non-destructive - disable it and the webGUI is 100% stock. Self-contained: one .plg, no external runtime dependencies.</Overview>

  <!-- Must match the pluginURL in the .plg file exactly -->
  <PluginURL>https://github.com/benjaminmue/unraid-themer/raw/refs/heads/main/unraid-themer.plg</PluginURL>

  <PluginAuthor>benjaminmue</PluginAuthor>

  <!-- Optional entries -->
  <!-- The .plg already carries a support attribute, so this is a fallback -->
  <Support>https://github.com/benjaminmue/unraid-themer/issues</Support>
  <Project>https://github.com/benjaminmue/unraid-themer</Project>
  <ReadMe>https://raw.githubusercontent.com/benjaminmue/unraid-themer/main/README.md</ReadMe>

  <Category>Tools:System</Category>

  <!-- Launching in beta -->
  <Beta>true</Beta>

  <!-- font awesome 4.7 icon name without the fa- prefix (matches the plugin icon) -->
  <IconFA>paint-brush</IconFA>

  <License>MIT</License>

  <Screenshot>https://raw.githubusercontent.com/benjaminmue/unraid-themer/main/docs/screenshots/01-dashboard.png</Screenshot>
  <Screenshot>https://raw.githubusercontent.com/benjaminmue/unraid-themer/main/docs/screenshots/02-settings.png</Screenshot>
  <Screenshot>https://raw.githubusercontent.com/benjaminmue/unraid-themer/main/docs/screenshots/03-themer-icons.png</Screenshot>
</Plugin>
