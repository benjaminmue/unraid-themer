Menu="Utilities"
Title="Unraid Themer"
Icon="paint-brush"
---
<?php
/* Unraid Themer — settings page (Settings → Utilities → Unraid Themer).
 * Lets the user enable the theme, pick a preset, and add custom CSS overrides.
 * Source of truth is flash (/boot/config/plugins/unraid.themer); files are
 * mirrored to the RAM webroot so nginx can serve them.
 */
require_once "$docroot/plugins/dynamix/include/Wrappers.php";

/* Validate imported CSS before we ever write it to disk. Returns [clean, error].
 * This is the security core of the theme store: reject anything that could run
 * code or phone home. Same ruleset the future publish-bot will use. */
function themer_sanitize_css($css) {
    $css = (string) $css;
    if (trim($css) === '')        return ["", "empty or download failed"];
    if (strlen($css) > 512 * 1024) return ["", "file too large (>512 KB)"];
    $blocked = [
        '/<\s*script/i'                          => "contains a <script> tag",
        '/<\s*\/?\s*(iframe|object|embed|base)/i' => "contains embedded HTML",
        '/javascript\s*:/i'                      => "contains a javascript: URI",
        '/expression\s*\(/i'                     => "contains a CSS expression()",
        '/behaviou?r\s*:/i'                      => "contains a CSS behavior:",
        '/-moz-binding/i'                        => "contains -moz-binding",
        '/@import/i'                             => "contains @import",
        '/url\s*\(\s*[\'"]?\s*(https?:|\/\/)/i'  => "loads an external url()",
    ];
    foreach ($blocked as $re => $why) {
        if (preg_match($re, $css)) return ["", $why];
    }
    return [$css, ""];
}

$name        = "unraid.themer";
$flash       = "/boot/config/plugins/$name";
$webroot     = "/usr/local/emhttp/plugins/$name";
$cfg_path    = "$flash/$name.cfg";
$custom_flash= "$flash/custom.css";
$custom_web  = "$webroot/custom.css";
// github.com/.../raw/ serves fresh content immediately; raw.githubusercontent
// is CDN-cached (~5 min), so new store themes would appear late.
$store_base  = "https://github.com/benjaminmue/unraid-themer/raw/refs/heads/main/themes";
$msg = "";
$switch_base = "";   // set to a theme name if we need to pair the Dynamix base

// download + sanitise a theme into the presets folder; returns "" or an error
function themer_fetch_theme($url, $flash, $webroot) {
    $raw = shell_exec("curl -fsSL --max-time 20 --max-filesize 524288 " . escapeshellarg($url) . " 2>/dev/null");
    [$clean, $err] = themer_sanitize_css($raw);
    if ($err) return $err;
    $stem = preg_replace('/[^a-z0-9_-]/', '', strtolower(pathinfo((string) parse_url($url, PHP_URL_PATH), PATHINFO_FILENAME)));
    if ($stem === '' || $stem === 'none') $stem = 'imported';
    @mkdir("$flash/presets", 0755, true);
    file_put_contents("$flash/presets/$stem.css", $clean);
    @copy("$flash/presets/$stem.css", "$webroot/presets/$stem.css");
    return "";  // success
}

// --- SAVE ---
if ($_POST && isset($_POST['SAVE_CONFIG'])) {
    $service = ($_POST['SERVICE'] ?? "disabled") === "enabled" ? "enabled" : "disabled";
    $preset  = preg_replace('/[^A-Za-z0-9._-]/', '', $_POST['PRESET'] ?? 'bebamu');
    if ($preset === '') $preset = 'none';
    $iconset = preg_replace('/[^A-Za-z0-9._-]/', '', $_POST['ICONSET'] ?? 'default');
    if ($iconset === '') $iconset = 'default';
    @mkdir($flash, 0755, true);
    file_put_contents($cfg_path, "SERVICE=\"$service\"\nPRESET=\"$preset\"\nICONSET=\"$iconset\"\n");

    if (isset($_POST['custom_css'])) {
        // normalise newlines, store on flash, mirror to webroot
        $css = str_replace("\r\n", "\n", $_POST['custom_css']);
        file_put_contents($custom_flash, $css);
        @copy($custom_flash, $custom_web);
    }

    // Auto-pair the base theme: the Vue web-components (notifications, etc.) and
    // Community Apps render light/dark by the BASE Dynamix theme, not by us. A
    // preset can declare `themer-base: black|white`; if the base doesn't match,
    // switch it via Unraid's own canonical writer below.
    $sel_file = "$webroot/presets/$preset.css";
    if ($service === "enabled" && is_file($sel_file)
        && preg_match('/themer-base:\s*(black|white|azure|gray)/i', file_get_contents($sel_file), $m)) {
        $want = strtolower($m[1]);
        $cur  = @parse_ini_file('/boot/config/plugins/dynamix/dynamix.cfg', true)['display']['theme'] ?? 'white';
        if ($want !== $cur) $switch_base = $want;
    }

    $msg = $switch_base
        ? "Settings saved. Switching the base theme to \"" . ucfirst($switch_base) . "\" and reloading…"
        : "Settings saved. Reload the browser (Cmd/Ctrl+Shift+R) to see changes.";
}

// --- IMPORT A THEME FROM A URL (theme store, mode A) ---
if ($_POST && isset($_POST['IMPORT_URL'])) {
    $url = trim($_POST['import_url'] ?? '');
    if (!preg_match('#^https://[^\s\'"<>]+\.css([?\#].*)?$#i', $url)) {
        $msg = "Enter an https:// URL that ends in .css";
    } else {
        $err = themer_fetch_theme($url, $flash, $webroot);
        $msg = $err ? "Import rejected — $err." : "Imported. Pick it in the preset dropdown above and click Apply.";
    }
}

// --- GET A THEME FROM THE STORE (theme store, mode B) ---
if ($_POST && isset($_POST['store_get'])) {
    $file = preg_replace('/[^A-Za-z0-9_.-]/', '', $_POST['store_get']);
    if ($file !== '' && substr($file, -4) === '.css') {
        $err = themer_fetch_theme("$store_base/$file", $flash, $webroot);
        $msg = $err
            ? "Store download rejected — $err."
            : "Added \"" . pathinfo($file, PATHINFO_FILENAME) . "\" from the store. Pick it in the dropdown and Apply.";
    }
}

// --- REMOVE A USER-ADDED THEME ---
if ($_POST && isset($_POST['remove_preset'])) {
    $r = preg_replace('/[^A-Za-z0-9_-]/', '', $_POST['remove_preset']);
    // only files that live on flash are user-added (bundled presets are recreated
    // from the .plg on boot, so removing them would be pointless)
    if ($r !== '' && is_file("$flash/presets/$r.css")) {
        @unlink("$flash/presets/$r.css");
        @unlink("$webroot/presets/$r.css");
        // if it was the active preset, fall back to bebamu
        $cur = parse_plugin_cfg($name);
        if (($cur['PRESET'] ?? '') === $r) {
            $svc = $cur['SERVICE'] ?? 'disabled';
            $ico = $cur['ICONSET'] ?? 'default';
            file_put_contents($cfg_path, "SERVICE=\"$svc\"\nPRESET=\"bebamu\"\nICONSET=\"$ico\"\n");
        }
        $msg = "Removed \"$r\".";
    }
}

// --- INIT / READ ---
if (!file_exists($custom_flash)) {
    @mkdir($flash, 0755, true);
    file_put_contents($custom_flash, "/* Your custom CSS overrides — loaded on top of the selected preset. */\n");
    @copy($custom_flash, $custom_web);
}
$settings    = parse_plugin_cfg($name);
$service     = $settings['SERVICE'] ?? "disabled";
$preset_sel  = $settings['PRESET']  ?? "bebamu";
$iconset_sel = $settings['ICONSET'] ?? "default";
$custom_css  = file_exists($custom_flash) ? file_get_contents($custom_flash) : "";

// available icon sets (default + any bundled icons/*.css)
$iconsets = ['default'];
foreach (glob("$webroot/icons/*.css") as $ic) $iconsets[] = basename($ic, '.css');

// discover presets shipped in the webroot
$presets = [];
foreach (glob("$webroot/presets/*.css") as $p) $presets[] = basename($p, '.css');
sort($presets);
$have_preset = array_flip($presets);

// user-added themes live on flash (bundled ones are recreated from the .plg) → removable
$user_presets = [];
foreach (glob("$flash/presets/*.css") as $p) $user_presets[] = basename($p, '.css');
sort($user_presets);

// fetch the community theme store index (best-effort, short timeout)
$store_index = null;
$raw = shell_exec("curl -fsSL --connect-timeout 4 --max-time 8 " . escapeshellarg("$store_base/index.json") . " 2>/dev/null");
if ($raw) $store_index = @json_decode($raw, true);

// Build the "Added themes" and "Theme store" blocks as HTML strings, echoed
// inline in the form so Unraid's markdown parser keeps them in the value column.
$btn = 'display:inline-block; width:auto; padding:2px 12px; min-width:88px;';

// theme store rows — three button states: Get / Uninstall (user-added) / Installed (built-in)
$store_stems = [];
if (!empty($store_index['themes'])) {
    $rows = "";
    foreach ($store_index['themes'] as $t) {
        $stem = pathinfo($t['file'], PATHINFO_FILENAME);
        $store_stems[$stem] = 1;
        $ins     = isset($have_preset[$stem]);
        $onflash = is_file("$flash/presets/$stem.css");   // present on flash → user-added → removable
        $base = strtolower($t['base'] ?? '');
        $L = in_array($base, ['white', 'azure', 'any']) ? '1' : '0';
        $D = in_array($base, ['black', 'gray', 'any']) ? '1' : '0';
        $dn = htmlspecialchars(strtolower($t['name'] . ' ' . $t['description']));
        if (!$ins) {
            $b = "<button type='submit' name='store_get' value='" . htmlspecialchars($t['file']) . "' style='$btn'>Get</button>";
        } elseif ($onflash) {
            $b = "<button type='submit' name='remove_preset' value='$stem' onclick='return confirm(\"Uninstall $stem?\")' style='$btn'>Uninstall</button>";
        } else {
            $b = "<button type='button' disabled style='$btn'>Installed</button>";
        }
        $rows .= "<div class='ut-store-row' data-name='$dn' data-light='$L' data-dark='$D' style='display:flex; align-items:baseline; gap:10px; padding:6px 8px; border-top:1px solid rgba(128,128,128,0.18);'>"
            . $b
            . "<span><strong>" . htmlspecialchars($t['name']) . "</strong> &mdash; " . htmlspecialchars($t['description']) . " <em style='opacity:.6;'>(" . htmlspecialchars($t['base']) . " &middot; " . htmlspecialchars($t['author']) . ")</em></span>"
            . "</div>";
    }
    $n = count($store_index['themes']);
    $storeHtml = "<div style='max-width:660px;'>"
        . "<div style='display:flex; gap:8px; margin-bottom:8px; align-items:center;'><input type='text' id='ut-store-search' placeholder='Search themes…' autocomplete='off' onkeyup='utStoreFilter()' style='flex:1; min-width:0;'><select id='ut-store-filter' onchange='utStoreFilter()' style='width:auto;'><option value='all'>All</option><option value='light'>Light</option><option value='dark'>Dark</option></select></div>"
        . "<div id='ut-store-list' style='max-height:320px; overflow-y:auto; border:1px solid rgba(128,128,128,0.25);'>$rows</div>"
        . "<span>$n community themes from the <a href='https://github.com/benjaminmue/unraid-themer/tree/main/themes' target='_blank'>registry</a> &mdash; downloaded on demand and validated before saving.</span>"
        . "</div>"
        . "<script>function utStoreFilter(){var q=(document.getElementById('ut-store-search').value||'').toLowerCase().trim();var f=document.getElementById('ut-store-filter').value;var rows=document.querySelectorAll('#ut-store-list .ut-store-row');for(var i=0;i<rows.length;i++){var r=rows[i];var okq=!q||r.getAttribute('data-name').indexOf(q)>=0;var okf=f=='all'||(f=='light'&&r.getAttribute('data-light')=='1')||(f=='dark'&&r.getAttribute('data-dark')=='1');r.style.display=(okq&&okf)?'':'none';}}</script>";
} else {
    $storeHtml = "<span>Store unavailable (no internet, or GitHub unreachable). The URL import above still works.</span>";
}

// "Added themes" now only covers user imports that AREN'T in the registry
// (arbitrary URL imports); registry themes are removed via "Uninstall" in the store.
$orphans = array_values(array_diff($user_presets, array_keys($store_stems)));
if ($orphans) {
    $addedHtml = "";
    foreach ($orphans as $up) {
        $lbl = htmlspecialchars(ucwords(str_replace(['-', '_'], ' ', $up)));
        $val = htmlspecialchars($up);
        $addedHtml .= "<button type='submit' name='remove_preset' value='$val' onclick='return confirm(\"Remove $val?\")' style='$btn margin:0 6px 6px 0;'>$lbl &times;</button>";
    }
    $addedHtml .= "<br><span>Themes you imported by URL that aren't in the store. Click to remove.</span>";
} else {
    $addedHtml = "<span>Store themes are removed with <strong>Uninstall</strong> in the store above; built-in themes stay.</span>";
}
?>

<div markdown="1">
<?php if ($msg): ?>
<span class="green"><?= htmlspecialchars($msg) ?></span>
<?php endif; ?>
</div>

<?php if ($switch_base): ?>
<script>
// Pair the Dynamix base theme with the selected preset, using Unraid's own
// config writer (csrf is auto-appended by the global ajaxPrefilter), then reload.
$(function () {
  $.post('/update.php', {
    '#file': 'dynamix/dynamix.cfg',
    '#section': 'display',
    'theme': '<?= $switch_base ?>'
  }).always(function () { setTimeout(function () { location.reload(); }, 600); });
});
</script>
<?php endif; ?>

<form markdown="1" method="POST" action="/Settings/UnraidThemer">

Enable Unraid Themer:
: <select name="SERVICE" size="1">
    <?= mk_option($service, "enabled", "Yes") ?>
    <?= mk_option($service, "disabled", "No") ?>
  </select>
  <span>When disabled, the webGUI is 100% stock — nothing is injected.</span>

Theme preset:
: <select name="PRESET" size="1">
    <?php foreach ($presets as $p): ?>
    <?= mk_option($preset_sel, $p, ucwords(str_replace(['-','_'],' ',$p))) ?>
    <?php endforeach; ?>
    <?= mk_option($preset_sel, "none", "None (custom CSS only)") ?>
  </select>
  <span>Applies on top of the Dynamix base theme. On <strong>Apply</strong> the base is paired automatically: dark presets switch it to <a href="/Settings/DisplaySettings" target="_blank">Black</a>, light presets to White — so tables, Community Apps and the Vue components render in the right mode with no manual step. "bebamu" is base-neutral (White = Light, Black = Dark). (Azure / Gray sidebar layouts are only partially themed for now.)</span>

Icon set:
: <select name="ICONSET" size="1">
    <?php foreach ($iconsets as $is): ?>
    <?= mk_option($iconset_sel, $is, ucfirst($is)) ?>
    <?php endforeach; ?>
  </select>
  <span>Swaps Unraid's UI glyphs (Docker, CPU, disks, fan…) for an icon set that tints with the theme. <strong>Lucide</strong> is a clean open-source (MIT) line set; <strong>Default</strong> keeps Unraid's own icons.</span>

Custom CSS overrides:
: <textarea name="custom_css" spellcheck="false" style="font-family:monospace; width:100%; max-width:820px; height:45vh; background:#111; color:#eee; border:1px solid #444; padding:10px;"><?= htmlspecialchars($custom_css) ?></textarea>
  <span>Optional. Loaded <em>after</em> the preset, so these rules win. Use Unraid CSS variables, e.g. <code>:root { --background-color:#101010; }</code>.</span>

Import a theme (URL):
: <input type="text" name="import_url" spellcheck="false" placeholder="https://…/theme.css" style="width:100%; max-width:560px;">
  <input type="submit" name="IMPORT_URL" value="Import">
  <span>Paste a raw <code>.css</code> URL (e.g. from GitHub) to add a community theme. It is downloaded, <strong>validated</strong> (scripts, <code>javascript:</code>, <code>@import</code> and external <code>url()</code> are rejected) and added to the preset dropdown.</span>

Theme store:
: <?= $storeHtml ?>

Added themes:
: <?= $addedHtml ?>

&nbsp;
: <span class="buttons-spaced">
    <input type="submit" name="SAVE_CONFIG" value="_(Apply)_">
    <input type="button" value="_(Done)_" onclick="done()">
  </span>

&nbsp;
: <span class="description" style="max-width:640px; margin:0; padding:15px; background:rgba(0,0,0,0.1); border-radius:6px;">
    <strong>How it works.</strong> Unraid Themer injects the selected preset's stylesheet into every page (via a <code>Buttons</code> loader page), plus a small deferred script for shadow-DOM tweaks and Docker "update available" badges.<br/><br/>
    <strong>Presets</strong> are CSS files in <code>/boot/config/plugins/unraid.themer/presets/</code> — drop your own <code>&lt;name&gt;.css</code> there to add one.<br/><br/>
    Explore Unraid's variables in <a href="/webGui/styles/themes/white.css" target="_blank">white.css</a> / <a href="/webGui/styles/themes/black.css" target="_blank">black.css</a>. Semantic status colors (disk health, array state) are intentionally left untouched by all presets.
  </span>
</form>
