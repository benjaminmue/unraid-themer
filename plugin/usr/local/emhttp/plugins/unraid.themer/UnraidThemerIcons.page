<div markdown="1">
<?php if ($msg): ?>
<span class="green"><?= htmlspecialchars($msg) ?></span>
<?php endif; ?>

Assign a custom icon to any slot below. Leave a field empty to keep the icon-set default.
A value can be a **bundled Lucide name** (type to autocomplete), a raw **https SVG URL**
(e.g. from [lucide.dev](https://lucide.dev) or [tabler-icons](https://tabler.io/icons)), or
pasted **`<svg>…</svg>`** markup. Custom SVGs are validated (no scripts/handlers/external refs)
and tinted with the theme color, so single-color line icons work best.
</div>

<form method="POST" action="/Settings/UnraidThemerIcons" autocomplete="off">
<datalist id="ut-bundled">
  <?php foreach ($bundled as $b): ?><option value="<?= htmlspecialchars($b) ?>"><?php endforeach; ?>
</datalist>

<table id="ut-icons">
  <thead>
    <tr><th>Icon</th><th>Set&nbsp;icon</th><th>Yours</th><th>Custom (name, https URL or &lt;svg&gt;)</th></tr>
  </thead>
  <tbody>
  <?php foreach ($REG as $cat => $slots): ?>
    <tr class="ut-cat"><td colspan="4"><?= htmlspecialchars($cat) ?></td></tr>
    <?php foreach ($slots as $key => $e):
        [$label, $sel, $def] = $e;
        $ref_url = isset($have_bundled[$def]) ? "$weburl/icons/svg/$def.svg" : "";
        $src = $map[$key] ?? '';
        [$own_url] = $src !== '' ? themer_resolve_icon($key, $src, $ctx) : ['', ''];
    ?>
    <tr>
      <td class="ut-desc"><?= htmlspecialchars($label) ?></td>
      <td><?= themer_prev($ref_url, $def) ?></td>
      <td class="ut-own" data-key="<?= htmlspecialchars($key) ?>"><?= themer_prev($own_url, $src) ?></td>
      <td><input type="text" name="ov_<?= htmlspecialchars($key) ?>" list="ut-bundled"
                 value="<?= htmlspecialchars($src) ?>" spellcheck="false"
                 placeholder="<?= htmlspecialchars($def) ?>"
                 oninput="utIconPrev(this)" data-key="<?= htmlspecialchars($key) ?>"></td>
    </tr>
    <?php endforeach; ?>
  <?php endforeach; ?>
  </tbody>
</table>

<p style="margin-top:16px;">
  <input type="submit" name="SAVE_ICONS" value="_(Apply)_">
  <input type="submit" name="RESET_ICONS" value="Reset all" onclick="return confirm('Clear all custom icons?')">
  <input type="button" value="_(Done)_" onclick="done()">
</p>
</form>

<script>
// Live preview for bundled Lucide names (same-origin SVGs). URLs / <svg> markup are
// previewed after Apply (server validates first).
var UT_BUNDLED = <?= json_encode($bundled) ?>;
function utIconPrev(inp){
  var key = inp.getAttribute('data-key');
  var cell = document.querySelector('.ut-own[data-key="'+key+'"]');
  if(!cell) return;
  var span = cell.querySelector('span');
  var v = (inp.value||'').trim().toLowerCase();
  if(v && UT_BUNDLED.indexOf(v) >= 0){
    var u = '<?= $weburl ?>/icons/svg/'+v+'.svg';
    span.style.webkitMask = 'url("'+u+'") center/contain no-repeat';
    span.style.mask = 'url("'+u+'") center/contain no-repeat';
    span.style.backgroundColor = 'currentColor';
    span.style.opacity = '1';
    span.innerHTML = '';
  }
}
</script>
