}
a.blue-text, .blue-text { color: var(--ghl-accent) !important; }
#docker_view .blue-text { color: var(--ghl-accent2) !important; }
#menu .nav-item.active a { color: var(--ghl-accent) !important; }
#menu .nav-item.active:after { background: var(--ghl-accent) !important; }
.greenbar { background: var(--usage-bar-used-background-color) !important; }
