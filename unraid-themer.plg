<FILE Name="/usr/local/emhttp/plugins/unraid.themer/presets/solarized-dark.css">
<INLINE>
<![CDATA[/* Unraid Themer preset: Solarized Dark — teal/cyan-blue accents on deep base03/base02 */
:root {
  /* ---------------- Palette ---------------- */
  --solar-bg: #002B36;
  --solar-bg2: #073642;
  --solar-surface: #0B3A46;
  --solar-text: #EEE8D5;
  --solar-dim: #93A1A1;
