  #ut-icons .ut-pick { flex: none; width: 30px; height: 28px; padding: 0; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  #ut-icons .ut-pick span { width: 16px; height: 16px; background-color: currentColor;
    -webkit-mask: url('<?= $weburl ?>/icons/svg/list.svg') center/contain no-repeat; mask: url('<?= $weburl ?>/icons/svg/list.svg') center/contain no-repeat; }
  #ut-icons .ut-up span { -webkit-mask-image: url('<?= $weburl ?>/icons/svg/upload.svg'); mask-image: url('<?= $weburl ?>/icons/svg/upload.svg'); }

  /* visual icon picker (modal grid) */
  #ut-picker-backdrop { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 9998; }
  #ut-picker { display: none; position: fixed; z-index: 9999; top: 50%; left: 50%; transform: translate(-50%,-50%);
    width: min(560px, 92vw); max-height: 78vh; background: var(--background-color, #1c1f26); color: var(--text-color, #e6e6e6);
    border: 1px solid rgba(128,128,128,0.4); border-radius: 10px; box-shadow: 0 12px 40px rgba(0,0,0,.5); display: none; flex-direction: column; }
  #ut-picker.open { display: flex; }
  #ut-picker-head { display: flex; gap: 8px; align-items: center; padding: 12px; border-bottom: 1px solid rgba(128,128,128,0.25); }
  #ut-picker-head input { flex: 1; }
  #ut-picker-head .ut-x { flex: none; cursor: pointer; padding: 4px 10px; }
  #ut-picker-grid { overflow-y: auto; padding: 10px; display: grid; grid-template-columns: repeat(auto-fill, minmax(64px, 1fr)); gap: 6px; }
  .ut-pick-item { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 8px 4px; cursor: pointer;
    background: transparent; border: 1px solid transparent; border-radius: 8px; color: inherit; }
  .ut-pick-item:hover { border-color: rgba(128,128,128,0.4); background: rgba(128,128,128,0.12); }
  .ut-pick-item span.ico { width: 24px; height: 24px; background-color: currentColor;
    -webkit-mask-position: center; mask-position: center; -webkit-mask-size: contain; mask-size: contain; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; }
  .ut-pick-item small { font-size: 10px; opacity: .7; max-width: 60px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
</style>

<div markdown="1">
<?php if ($msg): ?>
<span class="green"><?= htmlspecialchars($msg) ?></span>
<?php endif; ?>

<a href="/Settings/UnraidThemer">&larr; Back to Unraid Themer</a>

Assign a custom icon to any slot below. Leave a field empty to keep the icon-set default.
Use the **grid button** to pick from the bundled icons, the **upload button** to upload your
own **SVG file**, or type into the field: a **bundled name**, a raw **https SVG URL**
(e.g. from [lucide.dev](https://lucide.dev) or [tabler.io/icons](https://tabler.io/icons)), or
pasted **`<svg>…</svg>`** markup. Custom SVGs are validated (no scripts/handlers/external refs)
and tinted with the theme color, so single-color line icons work best.
</div>

<form method="POST" action="/Settings/UnraidThemerIcons" autocomplete="off" enctype="multipart/form-data">
<datalist id="ut-bundled">
  <?php foreach ($bundled as $b): ?><option value="<?= htmlspecialchars($b) ?>"><?php endforeach; ?>
</datalist>

<table id="ut-icons">
  <thead>
    <tr><th>Icon</th><th>Set&nbsp;icon</th><th>Yours</th><th>Custom (name, https URL or &lt;svg&gt;)</th></tr>
  </thead>
  <tbody>
  <?php foreach ($REG as $cat => $slots): ?>
    <tr class="ut-cat"><td colspan="4"><?= htmlspecialchars($cat) ?></td></tr>
    <?php foreach ($slots as $key => $e):
        [$label, $sel, $def] = $e;
        $ref_url = isset($have_bundled[$def]) ? "$weburl/icons/svg/$def.svg" : "";
        $src = $map[$key] ?? '';
        [$own_url] = $src !== '' ? themer_resolve_icon($key, $src, $ctx) : ['', ''];
    ?>
    <tr>
      <td class="ut-desc"><?= htmlspecialchars($label) ?></td>
      <td><?= themer_prev($ref_url, $def) ?></td>
      <td class="ut-own" data-key="<?= htmlspecialchars($key) ?>"><?= themer_prev($own_url, $src) ?></td>
      <td><div class="ut-cell">
        <button type="button" class="ut-pick" title="Pick from the icon grid" onclick="utOpenPicker('<?= htmlspecialchars($key) ?>')"><span></span></button>
        <button type="button" class="ut-pick ut-up" title="Upload an SVG file" onclick="document.getElementById('up_<?= htmlspecialchars($key) ?>').click()"><span></span></button>
        <input type="file" id="up_<?= htmlspecialchars($key) ?>" name="up_<?= htmlspecialchars($key) ?>" accept=".svg,image/svg+xml" style="display:none" onchange="utUploadPrev(this,'<?= htmlspecialchars($key) ?>')">
        <input type="text" name="ov_<?= htmlspecialchars($key) ?>" list="ut-bundled"
               value="<?= htmlspecialchars($src) ?>" spellcheck="false"
               placeholder="<?= htmlspecialchars($def) ?>"
               oninput="utIconPrev(this)" data-key="<?= htmlspecialchars($key) ?>">
      </div></td>
    </tr>
    <?php endforeach; ?>
  <?php endforeach; ?>
  </tbody>
</table>

<p style="margin-top:16px;">
  <input type="submit" name="SAVE_ICONS" value="_(Apply)_">
  <input type="submit" name="RESET_ICONS" value="Reset all" onclick="return confirm('Clear all custom icons?')">
  <input type="button" value="_(Done)_" onclick="done()">
</p>
</form>

<!-- visual icon picker: a searchable grid of the bundled Lucide icons -->
<div id="ut-picker-backdrop" onclick="utClosePicker()"></div>
<div id="ut-picker" role="dialog" aria-label="Pick an icon">
  <div id="ut-picker-head">
    <input type="text" id="ut-picker-search" placeholder="Search icons…" autocomplete="off" spellcheck="false" oninput="utPickerFilter()">
    <button type="button" class="ut-x" onclick="utClosePicker()">&times;</button>
  </div>
  <div id="ut-picker-grid">
    <?php foreach ($bundled as $b): $bu = htmlspecialchars($b); ?>
    <button type="button" class="ut-pick-item" data-name="<?= $bu ?>" title="<?= $bu ?>" onclick="utPick('<?= $bu ?>')">
      <span class="ico" style="-webkit-mask-image:url('<?= $weburl ?>/icons/svg/<?= $bu ?>.svg');mask-image:url('<?= $weburl ?>/icons/svg/<?= $bu ?>.svg');"></span>
      <small><?= $bu ?></small>
    </button>
    <?php endforeach; ?>
  </div>
</div>

<script>
// Live preview for bundled Lucide names (same-origin SVGs). URLs / <svg> markup are
// previewed after Apply (server validates first).
var UT_BUNDLED = <?= json_encode($bundled) ?>;
var UT_WEBURL  = '<?= $weburl ?>';
var UT_TARGET  = null;  // input being edited via the picker

function utIconPrev(inp){
  var key = inp.getAttribute('data-key');
  var cell = document.querySelector('.ut-own[data-key="'+key+'"]');
  if(!cell) return;
  var span = cell.querySelector('span');
  if(!span) return;
  var v = (inp.value||'').trim().toLowerCase();
  if(v && UT_BUNDLED.indexOf(v) >= 0){
    var u = UT_WEBURL+'/icons/svg/'+v+'.svg';
    span.style.webkitMask = 'url("'+u+'") center/contain no-repeat';
    span.style.mask = 'url("'+u+'") center/contain no-repeat';
    span.style.backgroundColor = 'currentColor';
    span.style.opacity = '1';
    span.innerHTML = '';
  }
}

function utUploadPrev(inp, key){
  var f = inp.files && inp.files[0];
  if(!f) return;
  var rd = new FileReader();
  rd.onload = function(){
    var cell = document.querySelector('.ut-own[data-key="'+key+'"]');
    if(cell){ var s = cell.querySelector('span'); if(s){
      s.style.webkitMask = 'url("'+rd.result+'") center/contain no-repeat';
      s.style.mask = 'url("'+rd.result+'") center/contain no-repeat';
      s.style.backgroundColor = 'currentColor'; s.style.opacity = '1'; s.innerHTML = '';
    }}
    var t = document.querySelector('input[data-key="'+key+'"]');
    if(t) t.value = 'upload';   // staged; the file wins on Apply
  };
  rd.readAsDataURL(f);
}
function utOpenPicker(key){
  UT_TARGET = document.querySelector('input[data-key="'+key+'"]');
  document.getElementById('ut-picker-backdrop').style.display = 'block';
  document.getElementById('ut-picker').classList.add('open');
  var s = document.getElementById('ut-picker-search');
  s.value = ''; utPickerFilter(); s.focus();
}
function utClosePicker(){
  document.getElementById('ut-picker-backdrop').style.display = 'none';
  document.getElementById('ut-picker').classList.remove('open');
  UT_TARGET = null;
}
function utPick(name){
  if(UT_TARGET){ UT_TARGET.value = name; utIconPrev(UT_TARGET); }
  utClosePicker();
}
function utPickerFilter(){
  var q = (document.getElementById('ut-picker-search').value||'').toLowerCase().trim();
  var items = document.querySelectorAll('#ut-picker-grid .ut-pick-item');
  for(var i=0;i<items.length;i++){
    var n = items[i].getAttribute('data-name');
    items[i].style.display = (!q || n.indexOf(q) >= 0) ? '' : 'none';
  }
}
document.addEventListener('keydown', function(e){ if(e.key === 'Escape') utClosePicker(); });
</script>
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/unraid.themer/UnraidThemerLoader.page">
<INLINE>
<![CDATA[Menu="Buttons:100"
Link="nav-user"
---
<?php
/* Unraid Themer — global loader.
 * Runs in <head> on every page (Menu="Buttons"). Injects the active preset
 * stylesheet, optional user overrides, and the runtime JS — only when enabled.
 *
 * IMPORTANT: this executes in the page's GLOBAL PHP scope, so it must NOT leak
 * variables (e.g. $name collides with Unraid's device/share name and breaks
 * those pages). Everything is wrapped in an immediately-invoked closure.
 */
(function () {
    global $docroot;
    require_once "$docroot/plugins/dynamix/include/Wrappers.php";

    $name    = "unraid.themer";
    $webroot = "/usr/local/emhttp/plugins/$name";
    $weburl  = "/plugins/$name";

    $cfg = parse_plugin_cfg($name);
    if (($cfg['SERVICE'] ?? "disabled") !== "enabled") return;

    // selected preset (sanitised to a safe filename stem)
    $preset = preg_replace('/[^A-Za-z0-9._-]/', '', $cfg['PRESET'] ?? 'bebamu');

    // 1) preset stylesheet
    if ($preset !== '' && $preset !== 'none') {
        $preset_file = "$webroot/presets/$preset.css";
        if (file_exists($preset_file)) {
            $v = filemtime($preset_file);
            echo "<link rel=\"stylesheet\" type=\"text/css\" href=\"$weburl/presets/$preset.css?v=$v\">\n";
        }
    }

    // 2) icon set (replaces Unraid's UI glyphs; loaded after the preset)
    $iconset = preg_replace('/[^A-Za-z0-9._-]/', '', $cfg['ICONSET'] ?? 'default');
    if ($iconset !== '' && $iconset !== 'default') {
        $icss = "$webroot/icons/$iconset.css";
        if (file_exists($icss)) {
            $v = filemtime($icss);
            echo "<link rel=\"stylesheet\" type=\"text/css\" href=\"$weburl/icons/$iconset.css?v=$v\">\n";
        }
    }

    // 3) per-icon overrides (loaded AFTER the icon set so single-icon swaps win,
    //    and work even when the icon set is "default")
    $ovcss = "$webroot/overrides.css";
    if (file_exists($ovcss) && trim(file_get_contents($ovcss)) !== '') {
        $v = filemtime($ovcss);
        echo "<link rel=\"stylesheet\" type=\"text/css\" href=\"$weburl/overrides.css?v=$v\">\n";
    }

    // 4) user custom overrides (loaded AFTER the preset so they win)
    $override = "$webroot/custom.css";
    if (file_exists($override) && trim(file_get_contents($override)) !== '') {
        $v = filemtime($override);
        echo "<link rel=\"stylesheet\" type=\"text/css\" href=\"$weburl/custom.css?v=$v\">\n";
    }

    // 3) runtime JS (shadow-DOM tweaks, update badges) — deferred, same-origin (CSP-safe)
    $js = "$webroot/js/themer.js";
    if (file_exists($js)) {
        $v = filemtime($js);
        echo "<script defer src=\"$weburl/js/themer.js?v=$v\"></script>\n";
    }
})();
?>
]]>
</INLINE>
</FILE>

