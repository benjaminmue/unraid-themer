  background-color: currentColor;
  display: inline-block; width: 1em; height: 1em; vertical-align: -0.125em;
}
/* --- Action icons: Font Awesome 4 (fa-*) used across Docker/VM/tile toolbars.
   Only specific fa-<name> glyphs are remapped; the base .fa class is untouched. --- */
.fa-play::before {
  content: "" !important;
  -webkit-mask: url('/plugins/unraid.themer/icons/svg/bootstrap/play.svg') center / contain no-repeat;
  mask: url('/plugins/unraid.themer/icons/svg/bootstrap/play.svg') center / contain no-repeat;
  background-color: currentColor;
  display: inline-block; width: 1em; height: 1em; vertical-align: -0.125em;
}
