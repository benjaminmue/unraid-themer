  --border-color: var(--gruvbox-border);
  --input-border-color: var(--gruvbox-border);
  --table-border-color: var(--gruvbox-border);
  --table-background-color: var(--gruvbox-bg2);
  --table-header-background-color: var(--gruvbox-surface);
