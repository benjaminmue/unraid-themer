<FILE Name="/usr/local/emhttp/plugins/unraid.themer/defaults/gruvbox-dark.css">
<INLINE>
<![CDATA[/* Unraid Themer preset: Gruvbox Dark — warm orange/yellow accents on retro-groove brown-grey */
:root {
  /* ---------------- Palette ---------------- */
  --gruvbox-bg: #282828;
  --gruvbox-bg2: #32302F;
  --gruvbox-surface: #3C3836;
  --gruvbox-text: #EBDBB2;
  --gruvbox-dim: #A89984;
  --gruvbox-border: #504945;
  --gruvbox-accent: #FE8019;
  --gruvbox-accent2: #FABD2F;

  /* ---------------- Dynamix core ---------------- */
  --text-color: var(--gruvbox-text);
  --alt-text-color: var(--gruvbox-dim);
  --link-text-color: var(--gruvbox-accent);

  --background-color: var(--gruvbox-bg);
  --mild-background-color: var(--gruvbox-bg2);

  --border-color: var(--gruvbox-border);
  --input-border-color: var(--gruvbox-border);
  --table-border-color: var(--gruvbox-border);
  --table-background-color: var(--gruvbox-bg2);
  --table-header-background-color: var(--gruvbox-surface);
  --hover-table-row-background-color: rgba(255, 255, 255, 0.05);
  --hr-color: var(--gruvbox-border);
  --shade-bg-color: var(--gruvbox-surface);
  --focus-input-bg-color: var(--gruvbox-surface);

  --header-background-color: var(--gruvbox-surface);
  --header-text-color: var(--gruvbox-text);
  --header-text-primary: var(--gruvbox-text);
  --header-text-secondary: var(--gruvbox-dim);

  --title-header-background-color: var(--gruvbox-bg2);

  --footer-text: var(--gruvbox-text);
  --footer-background-color: var(--gruvbox-surface);

  --usage-bar-background-color: rgba(255, 255, 255, 0.12);
  --usage-bar-used-background-color: var(--gruvbox-accent);
  --usage-disk-background-color: rgba(255, 255, 255, 0.12);

  --button-text-color: #ffffff;
  --button-background: var(--gruvbox-accent);
  --button-border: 1px solid var(--gruvbox-accent);

  --scrollbar-color: rgba(255, 255, 255, 0.3);
  --scrollbar-hover-color: var(--gruvbox-accent);
  --small-shadow: none;

  --dashboard-icon-color: var(--gruvbox-dim);

  /* ---------------- Brand remap (Unraid orange/blue -> Gruvbox orange/yellow) ---------------- */
  --orange-500: var(--gruvbox-accent);
  --orange-800: var(--gruvbox-accent2);
  --brand-orange: var(--gruvbox-accent);
  --brand-red: var(--gruvbox-accent2);
  --blue-700: var(--gruvbox-accent);
  --blue-800: var(--gruvbox-accent);

  /* ---------------- Unraid 7 UUI / shadcn web-component tokens ---------------- */
  --ui-bg: var(--gruvbox-bg);
  --ui-bg-muted: var(--gruvbox-bg2);
  --ui-bg-elevated: var(--gruvbox-surface);
  --ui-bg-accented: var(--gruvbox-surface);
  --ui-text: var(--gruvbox-text);
  --ui-text-muted: var(--gruvbox-dim);
  --ui-text-dimmed: var(--gruvbox-dim);
  --ui-text-highlighted: var(--gruvbox-text);
  --ui-border: var(--gruvbox-border);
  --ui-primary: var(--gruvbox-accent);
  --primary: var(--gruvbox-accent);
  --background: var(--gruvbox-bg);
  --foreground: var(--gruvbox-text);
  --card: var(--gruvbox-bg2);
  --popover: var(--gruvbox-bg2);
  --border: var(--gruvbox-border);
  --ring: var(--gruvbox-accent);
  --accent: var(--gruvbox-accent2);
}

/* ==================== Elemente ==================== */

/* flach + editorial */
.button, button, input, select, textarea, .tabs label {
  border-radius: 0 !important;
}
/* echte Buttons flach eingefärbt — Toggle-Wrapper (.apps/.vms/.compose-stacks) NICHT */
input[type="button"], input[type="submit"], input[type="reset"], button,
.button:not(.apps):not(.vms):not(.compose-stacks) {
  background: var(--gruvbox-accent) !important;
  color: #ffffff !important;
  border: 1px solid var(--gruvbox-accent) !important;
  box-shadow: none !important;
}

/* Echte Links -> Orange-Akzent */
a.blue-text, .blue-text { color: var(--gruvbox-accent) !important; }
/* Docker "Update verfügbar" -> zweiter Akzent (Gelb) */
#docker_view .blue-text { color: var(--gruvbox-accent2) !important; }

/* Aktiver Nav-Tab: Akzent-Text + Akzent-Unterstrich */
#menu .nav-item.active a { color: var(--gruvbox-accent) !important; }
#menu .nav-item.active:after { background: var(--gruvbox-accent) !important; }

/* Auslastungsbalken */
.greenbar { background: var(--usage-bar-used-background-color) !important; }
.redbar { background: var(--gruvbox-accent2) !important; }

/* Sektions-Titelbalken (Main-Seite) */
div.title { border-left: 3px solid var(--gruvbox-accent); }

/* Editoriale Dashboard-Boxen: crispe Haarlinie, flach, kein Schatten */
table.dashboard tbody {
  border: 1px solid var(--border-color) !important;
  border-radius: 0 !important;
  box-shadow: none !important;
}
/* Box-Titel linksbündig, Uppercase, getrackt */
.tile-header-left { justify-content: flex-start !important; }
.tile-header-main {
  text-align: left !important;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-weight: 800;
}
/* Akzent-Tick direkt vor dem Box-Titel */
.tile-header-main::before {
  content: "";
  display: inline-block;
  width: 3px;
  height: 0.95em;
