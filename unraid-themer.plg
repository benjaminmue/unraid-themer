  --ui-border: var(--nord-border);
  --ui-primary: var(--nord-accent);
  --primary: var(--nord-accent);
  --background: var(--nord-bg);
  --foreground: var(--nord-text);
  --card: var(--nord-bg2);
  --popover: var(--nord-bg2);
  --border: var(--nord-border);
