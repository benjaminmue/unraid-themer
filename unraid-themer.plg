  --ui-text: var(--rpd-text);
  --ui-text-muted: var(--rpd-dim);
  --ui-text-dimmed: var(--rpd-dim);
  --ui-text-highlighted: var(--rpd-text);
  --ui-border: var(--rpd-border);
  --ui-primary: var(--rpd-accent);
  --primary: var(--rpd-accent);
  --background: var(--rpd-bg);
  --foreground: var(--rpd-text);
  --card: var(--rpd-bg2);
  --popover: var(--rpd-bg2);
  --border: var(--rpd-border);
  --ring: var(--rpd-accent);
  --accent: var(--rpd-accent2);
}

/* ---------------- Elements (flat, editorial) ---------------- */
.button, button, input, select, textarea, .tabs label { border-radius: 0 !important; }
input[type="button"], input[type="submit"], input[type="reset"], button,
.button:not(.apps):not(.vms):not(.compose-stacks) {
  background: var(--rpd-accent) !important;
