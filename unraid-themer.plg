  --header-text-secondary: var(--nord-dim);

  --title-header-background-color: var(--nord-bg2);

  --footer-text: var(--nord-text);
  --footer-background-color: var(--nord-surface);

  --usage-bar-background-color: rgba(255, 255, 255, 0.12);
  --usage-bar-used-background-color: var(--nord-accent);
  --usage-disk-background-color: rgba(255, 255, 255, 0.12);

