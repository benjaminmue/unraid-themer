  background-color: currentColor;
  display: inline-block; width: 1em; height: 1em; vertical-align: -0.125em;
}
.icon-ups::before {
  content: "" !important;
  -webkit-mask: url('/plugins/unraid.themer/icons/svg/bootstrap/battery-charging.svg') center / contain no-repeat;
