<FILE Name="/usr/local/emhttp/plugins/unraid.themer/icons/carbon.css">
<INLINE>
<![CDATA[/* Unraid Themer icon set: Carbon — generated by scripts/gen_iconsets.py.
   Missing icons fall back to Lucide. */
/* Unraid Themer icon set: Lucide (MIT) — replaces Unraid's UI glyphs via CSS mask.
   Auto-tints with the theme text color (background: currentColor). */

.icon-performance::before {
  content: "" !important;
  -webkit-mask: url('/plugins/unraid.themer/icons/svg/carbon/gauge.svg') center / contain no-repeat;
  mask: url('/plugins/unraid.themer/icons/svg/carbon/gauge.svg') center / contain no-repeat;
