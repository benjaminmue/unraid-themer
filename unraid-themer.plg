<FILE Name="/usr/local/emhttp/plugins/unraid.themer/presets/gruvbox-dark.css">
<INLINE>
<![CDATA[/* Unraid Themer preset: Gruvbox Dark — warm orange/yellow accents on retro-groove brown-grey */
:root {
  /* ---------------- Palette ---------------- */
  --gruvbox-bg: #282828;
  --gruvbox-bg2: #32302F;
