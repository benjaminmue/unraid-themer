<FILE Name="/usr/local/emhttp/plugins/unraid.themer/icons/bootstrap.css">
<INLINE>
<![CDATA[/* Unraid Themer icon set: Bootstrap — generated by scripts/gen_iconsets.py.
   Missing icons fall back to Lucide. */
/* Unraid Themer icon set: Lucide (MIT) — replaces Unraid's UI glyphs via CSS mask.
   Auto-tints with the theme text color (background: currentColor). */

.icon-performance::before {
