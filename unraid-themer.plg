  background-color: currentColor;
  display: inline-block; width: 1em; height: 1em; vertical-align: -0.125em;
}
.fa-pause::before {
  content: "" !important;
  -webkit-mask: url('/plugins/unraid.themer/icons/svg/bootstrap/pause.svg') center / contain no-repeat;
  mask: url('/plugins/unraid.themer/icons/svg/bootstrap/pause.svg') center / contain no-repeat;
  background-color: currentColor;
  display: inline-block; width: 1em; height: 1em; vertical-align: -0.125em;
}
.fa-refresh::before,
.fa-rotate-right::before {
  content: "" !important;
  -webkit-mask: url('/plugins/unraid.themer/icons/svg/bootstrap/refresh-cw.svg') center / contain no-repeat;
  mask: url('/plugins/unraid.themer/icons/svg/bootstrap/refresh-cw.svg') center / contain no-repeat;
  background-color: currentColor;
  display: inline-block; width: 1em; height: 1em; vertical-align: -0.125em;
}
.fa-repeat::before,
.fa-rotate::before {
  content: "" !important;
  -webkit-mask: url('/plugins/unraid.themer/icons/svg/bootstrap/rotate-cw.svg') center / contain no-repeat;
  mask: url('/plugins/unraid.themer/icons/svg/bootstrap/rotate-cw.svg') center / contain no-repeat;
  background-color: currentColor;
  display: inline-block; width: 1em; height: 1em; vertical-align: -0.125em;
}
.fa-power-off::before {
  content: "" !important;
  -webkit-mask: url('/plugins/unraid.themer/icons/svg/bootstrap/power.svg') center / contain no-repeat;
  mask: url('/plugins/unraid.themer/icons/svg/bootstrap/power.svg') center / contain no-repeat;
  background-color: currentColor;
  display: inline-block; width: 1em; height: 1em; vertical-align: -0.125em;
}
.fa-cog::before,
.fa-gear::before {
  content: "" !important;
  -webkit-mask: url('/plugins/unraid.themer/icons/svg/bootstrap/settings.svg') center / contain no-repeat;
  mask: url('/plugins/unraid.themer/icons/svg/bootstrap/settings.svg') center / contain no-repeat;
  background-color: currentColor;
  display: inline-block; width: 1em; height: 1em; vertical-align: -0.125em;
}
.fa-trash::before,
.fa-trash-o::before {
  content: "" !important;
