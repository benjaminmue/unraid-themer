  --ui-text: var(--nord-text);
  --ui-text-muted: var(--nord-dim);
  --ui-text-dimmed: var(--nord-dim);
  --ui-text-highlighted: var(--nord-text);
  --ui-border: var(--nord-border);
  --ui-primary: var(--nord-accent);
  --primary: var(--nord-accent);
  --background: var(--nord-bg);
  --foreground: var(--nord-text);
  --card: var(--nord-bg2);
  --popover: var(--nord-bg2);
  --border: var(--nord-border);
  --ring: var(--nord-accent);
  --accent: var(--nord-accent2);
}

/* ==================== Elemente ==================== */

/* flach + editorial */
.button, button, input, select, textarea, .tabs label {
  border-radius: 0 !important;
}
/* echte Buttons flach eingefärbt — Toggle-Wrapper (.apps/.vms/.compose-stacks) NICHT */
input[type="button"], input[type="submit"], input[type="reset"], button,
.button:not(.apps):not(.vms):not(.compose-stacks) {
  background: var(--nord-accent) !important;
  color: #ffffff !important;
  border: 1px solid var(--nord-accent) !important;
  box-shadow: none !important;
}

/* Echte Links -> Frost-Akzent */
a.blue-text, .blue-text { color: var(--nord-accent) !important; }
/* Docker "Update verfügbar" -> zweiter Akzent */
#docker_view .blue-text { color: var(--nord-accent2) !important; }

/* Aktiver Nav-Tab: Akzent-Text + Akzent-Unterstrich */
#menu .nav-item.active a { color: var(--nord-accent) !important; }
