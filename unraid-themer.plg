}

/* ==================== Elemente ==================== */

/* flach + editorial */
.button, button, input, select, textarea, .tabs label {
  border-radius: 0 !important;
}
/* echte Buttons flach eingefärbt — Toggle-Wrapper (.apps/.vms/.compose-stacks) NICHT */
input[type="button"], input[type="submit"], input[type="reset"], button,
.button:not(.apps):not(.vms):not(.compose-stacks) {
  background: var(--solar-accent) !important;
