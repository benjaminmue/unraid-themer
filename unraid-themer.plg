<FILE Name="/usr/local/emhttp/plugins/unraid.themer/defaults/rose-pine-dawn.css">
<INLINE>
<![CDATA[/* Unraid Themer preset: Rose Pine Dawn — soft rosy light, iris and rose accents */
:root {
  /* ---------------- Palette (light) ---------------- */
  --rpd-bg: #faf4ed;
  --rpd-bg2: #fffaf3;
  --rpd-surface: #f2e9e1;
  --rpd-text: #575279;
  --rpd-dim: #797593;
  --rpd-border: #dfdad9;
  --rpd-accent: #907aa9;
  --rpd-accent2: #d7827e;

  /* ---------------- Dynamix core ---------------- */
  --text-color: var(--rpd-text);
  --alt-text-color: var(--rpd-dim);
  --link-text-color: var(--rpd-accent);

  --background-color: var(--rpd-bg);
  --mild-background-color: var(--rpd-bg2);

  --border-color: var(--rpd-border);
  --input-border-color: var(--rpd-border);
  --table-border-color: var(--rpd-border);
  --table-background-color: var(--rpd-bg2);
  --table-header-background-color: var(--rpd-surface);
  --hover-table-row-background-color: rgba(0, 0, 0, 0.045);
  --hr-color: var(--rpd-border);
  --shade-bg-color: var(--rpd-surface);
  --focus-input-bg-color: #ffffff;

  /* Header stays dark (like bebamu light) so the logo + web-component text read well */
  --header-background-color: #141414;
  --header-text-color: #f0f0f0;
  --header-text-primary: #f0f0f0;
  --header-text-secondary: rgba(240, 240, 240, 0.6);

  --title-header-background-color: var(--rpd-bg2);
  --footer-text: var(--rpd-text);
  --footer-background-color: var(--rpd-surface);

  --usage-bar-background-color: rgba(0, 0, 0, 0.12);
  --usage-bar-used-background-color: var(--rpd-accent);
  --usage-disk-background-color: rgba(0, 0, 0, 0.12);

  --button-text-color: #ffffff;
  --button-background: var(--rpd-accent);
  --button-background-size: auto;
  --button-border: 1px solid var(--rpd-accent);
  --hover-button-text-color: #ffffff;
  --hover-button-border: var(--rpd-text);

  --scrollbar-color: rgba(0, 0, 0, 0.3);
  --scrollbar-hover-color: var(--rpd-accent);
  --small-shadow: none;
  --dashboard-icon-color: var(--rpd-dim);

  /* brand + link remap */
  --orange-500: var(--rpd-accent);
  --orange-800: var(--rpd-accent2);
  --brand-orange: var(--rpd-accent);
  --brand-red: var(--rpd-accent2);
  --blue-700: var(--rpd-accent);
  --blue-800: var(--rpd-accent);

  /* Unraid 7 UUI / shadcn tokens */
  --ui-bg: var(--rpd-bg);
  --ui-bg-muted: var(--rpd-bg2);
  --ui-bg-elevated: var(--rpd-surface);
  --ui-bg-accented: var(--rpd-surface);
  --ui-text: var(--rpd-text);
  --ui-text-muted: var(--rpd-dim);
  --ui-text-dimmed: var(--rpd-dim);
  --ui-text-highlighted: var(--rpd-text);
  --ui-border: var(--rpd-border);
  --ui-primary: var(--rpd-accent);
  --primary: var(--rpd-accent);
  --background: var(--rpd-bg);
  --foreground: var(--rpd-text);
  --card: var(--rpd-bg2);
  --popover: var(--rpd-bg2);
  --border: var(--rpd-border);
  --ring: var(--rpd-accent);
  --accent: var(--rpd-accent2);
}

/* ---------------- Elements (flat, editorial) ---------------- */
.button, button, input, select, textarea, .tabs label { border-radius: 0 !important; }
input[type="button"], input[type="submit"], input[type="reset"], button,
.button:not(.apps):not(.vms):not(.compose-stacks) {
  background: var(--rpd-accent) !important;
  color: #ffffff !important;
  border: 1px solid var(--rpd-accent) !important;
  box-shadow: none !important;
}
a.blue-text, .blue-text { color: var(--rpd-accent) !important; }
#docker_view .blue-text { color: var(--rpd-accent2) !important; }
#menu .nav-item.active a { color: var(--rpd-accent) !important; }
#menu .nav-item.active:after { background: var(--rpd-accent) !important; }
.greenbar { background: var(--usage-bar-used-background-color) !important; }
.redbar { background: var(--rpd-accent2) !important; }
.orangebar { background: #c67100 !important; }
div.title { border-left: 3px solid var(--rpd-accent); }
table.dashboard tbody { border: 1px solid var(--border-color) !important; border-radius: 0 !important; box-shadow: none !important; }
.tile-header-left { justify-content: flex-start !important; }
.tile-header-main { text-align: left !important; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 800; }
.tile-header-main::before { content: ""; display: inline-block; width: 3px; height: 0.95em; background: var(--rpd-accent); margin-right: 9px; vertical-align: -1px; }

/* ---------------- compat: base-theme-driven surfaces ---------------- */
:root {
  --dynamix-tablesorter-tbody-row-bg-color: var(--table-background-color);
  --dynamix-tablesorter-tbody-row-alt-bg-color: var(--mild-background-color);
  --dynamix-tablesorter-tbody-row-border-color: var(--border-color);
  --dynamix-tablesorter-thead-th-bg-color: var(--table-header-background-color);
  --dynamix-tablesorter-thead-th-text-color: var(--text-color);
  --dynamix-tablesorter-thead-row-border-color: var(--border-color);
  --dynamix-select-bg-color: var(--table-background-color);
  --dynamix-box-text-color: var(--text-color);

  --template-background: var(--mild-background-color) !important;
  --template-hover-background: var(--shade-bg-color) !important;
  --ca-legacy-background-color: var(--background-color) !important;
  --sidebar-background: var(--mild-background-color) !important;
  --support-popup-background: var(--mild-background-color) !important;
  --ca-light-bg-color: var(--mild-background-color) !important;
  --ca-dark-text-color: var(--text-color) !important;
  --ca-medium-text-color: var(--alt-text-color) !important;
  --ca-light-text-color: var(--text-color) !important;
  --ca-lighter-text-color: var(--text-color) !important;
}

/*! themer-base: white */
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/unraid.themer/defaults/solarized-dark.css">
<INLINE>
<![CDATA[/* Unraid Themer preset: Solarized Dark — teal/cyan-blue accents on deep base03/base02 */
:root {
  /* ---------------- Palette ---------------- */
  --solar-bg: #002B36;
  --solar-bg2: #073642;
  --solar-surface: #0B3A46;
  --solar-text: #EEE8D5;
  --solar-dim: #93A1A1;
  --solar-border: #0A4653;
  --solar-accent: #268BD2;
  --solar-accent2: #2AA198;

  /* ---------------- Dynamix core ---------------- */
  --text-color: var(--solar-text);
  --alt-text-color: var(--solar-dim);
  --link-text-color: var(--solar-accent);

  --background-color: var(--solar-bg);
  --mild-background-color: var(--solar-bg2);

  --border-color: var(--solar-border);
  --input-border-color: var(--solar-border);
  --table-border-color: var(--solar-border);
  --table-background-color: var(--solar-bg2);
  --table-header-background-color: var(--solar-surface);
  --hover-table-row-background-color: rgba(255, 255, 255, 0.05);
  --hr-color: var(--solar-border);
  --shade-bg-color: var(--solar-surface);
  --focus-input-bg-color: var(--solar-surface);

  --header-background-color: var(--solar-surface);
  --header-text-color: var(--solar-text);
  --header-text-primary: var(--solar-text);
  --header-text-secondary: var(--solar-dim);

  --title-header-background-color: var(--solar-bg2);

  --footer-text: var(--solar-text);
  --footer-background-color: var(--solar-surface);

  --usage-bar-background-color: rgba(255, 255, 255, 0.12);
  --usage-bar-used-background-color: var(--solar-accent);
  --usage-disk-background-color: rgba(255, 255, 255, 0.12);

  --button-text-color: #ffffff;
  --button-background: var(--solar-accent);
  --button-border: 1px solid var(--solar-accent);

  --scrollbar-color: rgba(255, 255, 255, 0.3);
  --scrollbar-hover-color: var(--solar-accent);
  --small-shadow: none;

  --dashboard-icon-color: var(--solar-dim);

  /* ---------------- Brand remap (Unraid orange/blue -> Solarized blue/cyan) ---------------- */
  --orange-500: var(--solar-accent);
  --orange-800: var(--solar-accent2);
  --brand-orange: var(--solar-accent);
  --brand-red: var(--solar-accent2);
  --blue-700: var(--solar-accent);
  --blue-800: var(--solar-accent);

  /* ---------------- Unraid 7 UUI / shadcn web-component tokens ---------------- */
  --ui-bg: var(--solar-bg);
  --ui-bg-muted: var(--solar-bg2);
  --ui-bg-elevated: var(--solar-surface);
  --ui-bg-accented: var(--solar-surface);
  --ui-text: var(--solar-text);
  --ui-text-muted: var(--solar-dim);
  --ui-text-dimmed: var(--solar-dim);
  --ui-text-highlighted: var(--solar-text);
  --ui-border: var(--solar-border);
  --ui-primary: var(--solar-accent);
  --primary: var(--solar-accent);
  --background: var(--solar-bg);
  --foreground: var(--solar-text);
  --card: var(--solar-bg2);
  --popover: var(--solar-bg2);
  --border: var(--solar-border);
  --ring: var(--solar-accent);
  --accent: var(--solar-accent2);
}

/* ==================== Elemente ==================== */

/* flach + editorial */
.button, button, input, select, textarea, .tabs label {
  border-radius: 0 !important;
}
/* echte Buttons flach eingefärbt — Toggle-Wrapper (.apps/.vms/.compose-stacks) NICHT */
input[type="button"], input[type="submit"], input[type="reset"], button,
.button:not(.apps):not(.vms):not(.compose-stacks) {
  background: var(--solar-accent) !important;
  color: #ffffff !important;
  border: 1px solid var(--solar-accent) !important;
  box-shadow: none !important;
}

/* Echte Links -> Blau-Akzent */
a.blue-text, .blue-text { color: var(--solar-accent) !important; }
/* Docker "Update verfügbar" -> zweiter Akzent (Cyan) */
#docker_view .blue-text { color: var(--solar-accent2) !important; }

/* Aktiver Nav-Tab: Akzent-Text + Akzent-Unterstrich */
#menu .nav-item.active a { color: var(--solar-accent) !important; }
#menu .nav-item.active:after { background: var(--solar-accent) !important; }

/* Auslastungsbalken */
.greenbar { background: var(--usage-bar-used-background-color) !important; }
.redbar { background: var(--solar-accent2) !important; }

/* Sektions-Titelbalken (Main-Seite) */
div.title { border-left: 3px solid var(--solar-accent); }

/* Editoriale Dashboard-Boxen: crispe Haarlinie, flach, kein Schatten */
table.dashboard tbody {
  border: 1px solid var(--border-color) !important;
  border-radius: 0 !important;
  box-shadow: none !important;
}
/* Box-Titel linksbündig, Uppercase, getrackt */
.tile-header-left { justify-content: flex-start !important; }
.tile-header-main {
  text-align: left !important;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-weight: 800;
}
/* Akzent-Tick direkt vor dem Box-Titel */
.tile-header-main::before {
  content: "";
  display: inline-block;
  width: 3px;
  height: 0.95em;
  background: var(--solar-accent);
  margin-right: 9px;
  vertical-align: -1px;
}

/* ==================== compat: base-theme-driven surfaces ====================
   Tables (Plugins/Docker-advanced) and Community Applications ship their own
   light/dark CSS that follows the BASE Dynamix theme, not this preset. Remap
   their variables to this preset's own semantic vars so they match either way.
   Values reference vars every preset defines → identical block across presets. */
:root {
  /* Dynamix sortable tables */
  --dynamix-tablesorter-tbody-row-bg-color: var(--table-background-color);
  --dynamix-tablesorter-tbody-row-alt-bg-color: var(--mild-background-color);
  --dynamix-tablesorter-tbody-row-border-color: var(--border-color);
  --dynamix-tablesorter-thead-th-bg-color: var(--table-header-background-color);
  --dynamix-tablesorter-thead-th-text-color: var(--text-color);
  --dynamix-tablesorter-thead-row-border-color: var(--border-color);
  --dynamix-select-bg-color: var(--table-background-color);
  --dynamix-box-text-color: var(--text-color);

  /* Community Applications (own theme files — force to match this preset) */
  --template-background: var(--mild-background-color) !important;
  --template-hover-background: var(--shade-bg-color) !important;
  --ca-legacy-background-color: var(--background-color) !important;
  --sidebar-background: var(--mild-background-color) !important;
  --support-popup-background: var(--mild-background-color) !important;
  --ca-light-bg-color: var(--mild-background-color) !important;
  --ca-dark-text-color: var(--text-color) !important;
  --ca-medium-text-color: var(--alt-text-color) !important;
  --ca-light-text-color: var(--text-color) !important;
  --ca-lighter-text-color: var(--text-color) !important;
}

/*! themer-base: black */
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/unraid.themer/defaults/solarized-light.css">
<INLINE>
<![CDATA[/* Unraid Themer preset: Solarized Light — warm paper base, blue and cyan accents */
:root {
  /* ---------------- Palette (light) ---------------- */
  --sol-bg: #fdf6e3;
  --sol-bg2: #eee8d5;
  --sol-surface: #e3ddc7;
  --sol-text: #073642;
  --sol-dim: #657b83;
  --sol-border: #d9d2bd;
  --sol-accent: #268bd2;
  --sol-accent2: #2aa198;

  /* ---------------- Dynamix core ---------------- */
  --text-color: var(--sol-text);
  --alt-text-color: var(--sol-dim);
  --link-text-color: var(--sol-accent);

  --background-color: var(--sol-bg);
  --mild-background-color: var(--sol-bg2);

  --border-color: var(--sol-border);
  --input-border-color: var(--sol-border);
  --table-border-color: var(--sol-border);
  --table-background-color: var(--sol-bg2);
  --table-header-background-color: var(--sol-surface);
  --hover-table-row-background-color: rgba(0, 0, 0, 0.045);
  --hr-color: var(--sol-border);
  --shade-bg-color: var(--sol-surface);
  --focus-input-bg-color: #ffffff;

  /* Header stays dark (like bebamu light) so the logo + web-component text read well */
  --header-background-color: #141414;
  --header-text-color: #f0f0f0;
  --header-text-primary: #f0f0f0;
  --header-text-secondary: rgba(240, 240, 240, 0.6);

  --title-header-background-color: var(--sol-bg2);
  --footer-text: var(--sol-text);
  --footer-background-color: var(--sol-surface);

  --usage-bar-background-color: rgba(0, 0, 0, 0.12);
  --usage-bar-used-background-color: var(--sol-accent);
  --usage-disk-background-color: rgba(0, 0, 0, 0.12);

  --button-text-color: #ffffff;
  --button-background: var(--sol-accent);
  --button-background-size: auto;
  --button-border: 1px solid var(--sol-accent);
  --hover-button-text-color: #ffffff;
  --hover-button-border: var(--sol-text);

  --scrollbar-color: rgba(0, 0, 0, 0.3);
  --scrollbar-hover-color: var(--sol-accent);
  --small-shadow: none;
  --dashboard-icon-color: var(--sol-dim);

  /* brand + link remap */
  --orange-500: var(--sol-accent);
  --orange-800: var(--sol-accent2);
  --brand-orange: var(--sol-accent);
  --brand-red: var(--sol-accent2);
  --blue-700: var(--sol-accent);
  --blue-800: var(--sol-accent);

  /* Unraid 7 UUI / shadcn tokens */
  --ui-bg: var(--sol-bg);
  --ui-bg-muted: var(--sol-bg2);
  --ui-bg-elevated: var(--sol-surface);
  --ui-bg-accented: var(--sol-surface);
  --ui-text: var(--sol-text);
  --ui-text-muted: var(--sol-dim);
  --ui-text-dimmed: var(--sol-dim);
  --ui-text-highlighted: var(--sol-text);
  --ui-border: var(--sol-border);
  --ui-primary: var(--sol-accent);
  --primary: var(--sol-accent);
  --background: var(--sol-bg);
  --foreground: var(--sol-text);
  --card: var(--sol-bg2);
  --popover: var(--sol-bg2);
  --border: var(--sol-border);
  --ring: var(--sol-accent);
  --accent: var(--sol-accent2);
}

/* ---------------- Elements (flat, editorial) ---------------- */
.button, button, input, select, textarea, .tabs label { border-radius: 0 !important; }
input[type="button"], input[type="submit"], input[type="reset"], button,
.button:not(.apps):not(.vms):not(.compose-stacks) {
  background: var(--sol-accent) !important;
  color: #ffffff !important;
  border: 1px solid var(--sol-accent) !important;
  box-shadow: none !important;
}
a.blue-text, .blue-text { color: var(--sol-accent) !important; }
#docker_view .blue-text { color: var(--sol-accent2) !important; }
#menu .nav-item.active a { color: var(--sol-accent) !important; }
#menu .nav-item.active:after { background: var(--sol-accent) !important; }
.greenbar { background: var(--usage-bar-used-background-color) !important; }
.redbar { background: var(--sol-accent2) !important; }
.orangebar { background: #c67100 !important; }
div.title { border-left: 3px solid var(--sol-accent); }
table.dashboard tbody { border: 1px solid var(--border-color) !important; border-radius: 0 !important; box-shadow: none !important; }
.tile-header-left { justify-content: flex-start !important; }
.tile-header-main { text-align: left !important; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 800; }
.tile-header-main::before { content: ""; display: inline-block; width: 3px; height: 0.95em; background: var(--sol-accent); margin-right: 9px; vertical-align: -1px; }

/* ---------------- compat: base-theme-driven surfaces ---------------- */
:root {
  --dynamix-tablesorter-tbody-row-bg-color: var(--table-background-color);
  --dynamix-tablesorter-tbody-row-alt-bg-color: var(--mild-background-color);
  --dynamix-tablesorter-tbody-row-border-color: var(--border-color);
  --dynamix-tablesorter-thead-th-bg-color: var(--table-header-background-color);
  --dynamix-tablesorter-thead-th-text-color: var(--text-color);
  --dynamix-tablesorter-thead-row-border-color: var(--border-color);
  --dynamix-select-bg-color: var(--table-background-color);
  --dynamix-box-text-color: var(--text-color);

  --template-background: var(--mild-background-color) !important;
  --template-hover-background: var(--shade-bg-color) !important;
  --ca-legacy-background-color: var(--background-color) !important;
  --sidebar-background: var(--mild-background-color) !important;
  --support-popup-background: var(--mild-background-color) !important;
  --ca-light-bg-color: var(--mild-background-color) !important;
  --ca-dark-text-color: var(--text-color) !important;
  --ca-medium-text-color: var(--alt-text-color) !important;
  --ca-light-text-color: var(--text-color) !important;
  --ca-lighter-text-color: var(--text-color) !important;
}

/*! themer-base: white */
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/unraid.themer/icons/bootstrap.css">
<INLINE>
<![CDATA[/* Unraid Themer icon set: Bootstrap — generated by scripts/gen_iconsets.py.
   Missing icons fall back to Lucide. */
/* Unraid Themer icon set: Lucide (MIT) — replaces Unraid's UI glyphs via CSS mask.
   Auto-tints with the theme text color (background: currentColor). */

.icon-performance::before {
  content: "" !important;
  -webkit-mask: url('/plugins/unraid.themer/icons/svg/bootstrap/gauge.svg') center / contain no-repeat;
  mask: url('/plugins/unraid.themer/icons/svg/bootstrap/gauge.svg') center / contain no-repeat;
  background-color: currentColor;
  display: inline-block; width: 1em; height: 1em; vertical-align: -0.125em;
}
.icon-motherboard::before {
  content: "" !important;
  -webkit-mask: url('/plugins/unraid.themer/icons/svg/bootstrap/circuit-board.svg') center / contain no-repeat;
  mask: url('/plugins/unraid.themer/icons/svg/bootstrap/circuit-board.svg') center / contain no-repeat;
  background-color: currentColor;
  display: inline-block; width: 1em; height: 1em; vertical-align: -0.125em;
}
.icon-cpu::before {
  content: "" !important;
  -webkit-mask: url('/plugins/unraid.themer/icons/svg/bootstrap/cpu.svg') center / contain no-repeat;
  mask: url('/plugins/unraid.themer/icons/svg/bootstrap/cpu.svg') center / contain no-repeat;
  background-color: currentColor;
  display: inline-block; width: 1em; height: 1em; vertical-align: -0.125em;
}
.icon-ram::before {
