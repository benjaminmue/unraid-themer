  --ui-text-dimmed: var(--gruvbox-dim);
  --ui-text-highlighted: var(--gruvbox-text);
  --ui-border: var(--gruvbox-border);
  --ui-primary: var(--gruvbox-accent);
  --primary: var(--gruvbox-accent);
  --background: var(--gruvbox-bg);
  --foreground: var(--gruvbox-text);
  --card: var(--gruvbox-bg2);
  --popover: var(--gruvbox-bg2);
  --border: var(--gruvbox-border);
  --ring: var(--gruvbox-accent);
  --accent: var(--gruvbox-accent2);
}

/* ==================== Elemente ==================== */

/* flach + editorial */
.button, button, input, select, textarea, .tabs label {
  border-radius: 0 !important;
}
/* echte Buttons flach eingefärbt — Toggle-Wrapper (.apps/.vms/.compose-stacks) NICHT */
input[type="button"], input[type="submit"], input[type="reset"], button,
.button:not(.apps):not(.vms):not(.compose-stacks) {
  background: var(--gruvbox-accent) !important;
