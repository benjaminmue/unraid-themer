  --ui-bg-elevated: var(--ghl-surface);
  --ui-bg-accented: var(--ghl-surface);
  --ui-text: var(--ghl-text);
  --ui-text-muted: var(--ghl-dim);
  --ui-text-dimmed: var(--ghl-dim);
  --ui-text-highlighted: var(--ghl-text);
  --ui-border: var(--ghl-border);
  --ui-primary: var(--ghl-accent);
  --primary: var(--ghl-accent);
  --background: var(--ghl-bg);
  --foreground: var(--ghl-text);
  --card: var(--ghl-bg2);
  --popover: var(--ghl-bg2);
  --border: var(--ghl-border);
  --ring: var(--ghl-accent);
  --accent: var(--ghl-accent2);
}

/* ---------------- Elements (flat, editorial) ---------------- */
.button, button, input, select, textarea, .tabs label { border-radius: 0 !important; }
input[type="button"], input[type="submit"], input[type="reset"], button,
.button:not(.apps):not(.vms):not(.compose-stacks) {
  background: var(--ghl-accent) !important;
  color: #ffffff !important;
  border: 1px solid var(--ghl-accent) !important;
