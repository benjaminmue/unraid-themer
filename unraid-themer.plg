  --primary: var(--solar-accent);
  --background: var(--solar-bg);
  --foreground: var(--solar-text);
  --card: var(--solar-bg2);
  --popover: var(--solar-bg2);
  --border: var(--solar-border);
  --ring: var(--solar-accent);
  --accent: var(--solar-accent2);
}

/* ==================== Elemente ==================== */

/* flach + editorial */
.button, button, input, select, textarea, .tabs label {
  border-radius: 0 !important;
}
/* echte Buttons flach eingefärbt — Toggle-Wrapper (.apps/.vms/.compose-stacks) NICHT */
input[type="button"], input[type="submit"], input[type="reset"], button,
.button:not(.apps):not(.vms):not(.compose-stacks) {
  background: var(--solar-accent) !important;
  color: #ffffff !important;
  border: 1px solid var(--solar-accent) !important;
  box-shadow: none !important;
}

/* Echte Links -> Blau-Akzent */
a.blue-text, .blue-text { color: var(--solar-accent) !important; }
/* Docker "Update verfügbar" -> zweiter Akzent (Cyan) */
#docker_view .blue-text { color: var(--solar-accent2) !important; }

/* Aktiver Nav-Tab: Akzent-Text + Akzent-Unterstrich */
#menu .nav-item.active a { color: var(--solar-accent) !important; }
#menu .nav-item.active:after { background: var(--solar-accent) !important; }

/* Auslastungsbalken */
.greenbar { background: var(--usage-bar-used-background-color) !important; }
