  --rpd-accent: #907aa9;
  --rpd-accent2: #d7827e;

  /* ---------------- Dynamix core ---------------- */
  --text-color: var(--rpd-text);
  --alt-text-color: var(--rpd-dim);
  --link-text-color: var(--rpd-accent);

  --background-color: var(--rpd-bg);
  --mild-background-color: var(--rpd-bg2);

  --border-color: var(--rpd-border);
  --input-border-color: var(--rpd-border);
  --table-border-color: var(--rpd-border);
  --table-background-color: var(--rpd-bg2);
  --table-header-background-color: var(--rpd-surface);
  --hover-table-row-background-color: rgba(0, 0, 0, 0.045);
  --hr-color: var(--rpd-border);
  --shade-bg-color: var(--rpd-surface);
  --focus-input-bg-color: #ffffff;

  /* Header stays dark (like bebamu light) so the logo + web-component text read well */
  --header-background-color: #141414;
  --header-text-color: #f0f0f0;
  --header-text-primary: #f0f0f0;
  --header-text-secondary: rgba(240, 240, 240, 0.6);

  --title-header-background-color: var(--rpd-bg2);
  --footer-text: var(--rpd-text);
  --footer-background-color: var(--rpd-surface);

  --usage-bar-background-color: rgba(0, 0, 0, 0.12);
  --usage-bar-used-background-color: var(--rpd-accent);
  --usage-disk-background-color: rgba(0, 0, 0, 0.12);

  --button-text-color: #ffffff;
  --button-background: var(--rpd-accent);
  --button-background-size: auto;
  --button-border: 1px solid var(--rpd-accent);
  --hover-button-text-color: #ffffff;
  --hover-button-border: var(--rpd-text);

